---
# Vendored spire/ES libraries. These define the ECS component structs that
# get default-constructed on every frame; an uninitialized member here is
# just as dangerous as one in the SCIRun-side render glue (see GH #881).
InheritParentConfig: true
Checks: >
  -*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-init-variables
CheckOptions:
  - key:   cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value: false
  - key:   cppcoreguidelines-pro-type-member-init.UseAssignment
    value: true
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
